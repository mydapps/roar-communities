# Community Token System Environment Configuration

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# The private key of the deployer account (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# The address of the deployer account
DEPLOYER_ADDRESS=0x...

# The address that will own the contracts (should be dapps.co multisig)
OWNER_ADDRESS=0x...

# The platform treasury address (receives 0.25% of all trading fees)
PLATFORM_TREASURY=0x...

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Base Sepolia RPC URL
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# BaseScan API Key for contract verification
BASESCAN_API_KEY=your_basescan_api_key_here

# =============================================================================
# UNISWAP V4 CONFIGURATION
# =============================================================================

# Uniswap V4 Pool Manager address on Base Sepolia
# Note: This address needs to be updated when Uniswap V4 is deployed on Base Sepolia
UNISWAP_V4_POOL_MANAGER=0x...

# WETH address on Base Sepolia
WETH_BASE_SEPOLIA=0x4200000000000000000000000000000000000006

# =============================================================================
# COMMUNITY TOKEN CONFIGURATION
# =============================================================================

# Default base price for community tokens (in wei)
# Default: 5000000000000 (0.000005 ETH)
DEFAULT_BASE_PRICE=5000000000000

# Default community admin fee (in basis points)
# Default: 25 (0.25%)
COMMUNITY_ADMIN_FEE=25

# Default platform fee (in basis points)
# Default: 25 (0.25%)
PLATFORM_FEE=25

# Default rewards fee (in basis points)
# Default: 50 (0.5%)
REWARDS_FEE=50

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test community configuration
TEST_COMMUNITY_NAME="Test Community"
TEST_COMMUNITY_SYMBOL="TEST"
TEST_COMMUNITY_ID="test-community-1"
TEST_ADMIN_WALLET=0x...

# Test user addresses for testing
TEST_USER_1=0x...
TEST_USER_2=0x...

# =============================================================================
# FRONTEND INTEGRATION
# =============================================================================

# API endpoint for the dapps.co backend
DAPPS_API_ENDPOINT=https://api.dapps.co

# Frontend URL for redirect after community creation
FRONTEND_URL=https://dapps.co 